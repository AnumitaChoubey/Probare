# Environment
APPLICATION_ENV=development
API_V1_STR=/api/v1
PROJECT_NAME="QEMS Enterprise Backend"
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Database
# Use postgresql+asyncpg for async SQLAlchemy (Neon DB or local)
DATABASE_URL=postgresql+asyncpg://qems_user:qems_password@localhost:5432/qems_db

# Redis (Used for Rate Limiting and Caching)
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO local or S3 compatible)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=qems-evidence

# Authentication
# Options: "entra" or "clerk"
AUTH_PROVIDER=clerk

# Clerk Authentication (if AUTH_PROVIDER=clerk)
CLERK_ISSUER_URL=https://your-clerk-instance.clerk.accounts.dev
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Microsoft Entra ID Authentication (if AUTH_PROVIDER=entra)
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=

# AI Provider Configuration (Phase E)
# Options: "gemini", "mock" (mock not allowed in production)
AI_PROVIDER=gemini
AI_API_KEY=your-gemini-api-key

# Microsoft Graph & Teams Integration (Phase 2+)
MS_GRAPH_PROVIDER=mock
MS_GRAPH_WEBHOOK_SECRET=
TEAMS_WEBHOOK_URL=

# Background Workers (Phase C)
SLA_CHECK_INTERVAL_SECONDS=60
