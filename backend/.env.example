# Database Settings (Local Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=qems_dev

# Authentication - Central needs both, Desktop Sidecar only needs JWT_PUBLIC_KEY
# Generate with: python scripts/generate_keys.py
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----..."
JWT_PUBLIC_KEY="-----BEGIN RSA PUBLIC KEY-----..."
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Environment / Feature Flags
DEBUG=True
ENVIRONMENT=development
