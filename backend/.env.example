# Environment
APPLICATION_ENV=development
API_V1_STR=/api/v1
PROJECT_NAME="QEMS Enterprise Backend"
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Database
# Use postgresql+asyncpg for async SQLAlchemy
DATABASE_URL=postgresql+asyncpg://qems_user:qems_password@localhost:5432/qems_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=qems-evidence

# Microsoft Graph (Phase 2+)
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
MS_GRAPH_WEBHOOK_SECRET=
TEAMS_WEBHOOK_URL=

# AI Provider (Phase 2+)
AI_PROVIDER=gemini
AI_API_KEY=

# Clerk Authentication (Phase 9)
CLERK_ISSUER_URL=https://your-clerk-instance.clerk.accounts.dev
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
AUTH_PROVIDER=clerk

