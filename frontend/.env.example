# QEMS Frontend Environment Configuration

# Core API Configuration
# Points to the FastAPI backend URL (Production Render)
VITE_API_URL=https://probare.onrender.com/api/v1

# Authentication Provider Choice
# Options: "entra" or "clerk"
VITE_AUTH_PROVIDER=clerk

# Clerk Authentication (if VITE_AUTH_PROVIDER=clerk)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Microsoft Entra ID Authentication (if VITE_AUTH_PROVIDER=entra)
VITE_ENTRA_CLIENT_ID=your-client-id
VITE_ENTRA_TENANT_ID=your-tenant-id

# AI Feature Flags
# If true, routes AI requests to backend real provider endpoints instead of mock responses
VITE_USE_REAL_AI=true
